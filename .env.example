# Content Pipeline — fill these in YOUR OWN Supabase project and n8n instance.
# Nothing here is committed with real values; this file is documentation only.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key        # dashboard (browser) only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # n8n only — NEVER in the dashboard

# --- n8n credentials (created inside n8n, attached to the workflow nodes) ---
# Supabase API credential  → service_role key above
# OpenAI API credential    → platform.openai.com → API keys (draft-generator)
# YouTube OAuth2           → Google Cloud → YouTube Data API v3 (publisher)
# Header Auth: Facebook    → Page access token (publisher)
# Header Auth: Instagram   → User access token (publisher)
# Header Auth: TikTok      → TikTok access token (publisher)

# --- dashboard (browser localStorage, first-run settings form) ---
# SUPABASE_URL + SUPABASE_ANON_KEY pasted into the dashboard; optional:
DRAFT_WEBHOOK_URL=https://your-n8n/webhook/generate-draft
